<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تقرير استراتيجي - منصة مدارس المخا</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts (Cairo) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
  <style>
    /* Applying the Cairo font to the body */
    body {
      font-family: 'Cairo', sans-serif;
    }
  </style>
</head>
<body class="bg-gray-100">

  <!-- Main container with a card-like appearance -->
  <div class="container mx-auto max-w-5xl p-6 sm:p-8 md:p-12 bg-white shadow-2xl rounded-2xl my-10">

    <!-- Header Section -->
    <header class="text-center mb-10 border-b-4 border-teal-500 pb-6">
      <h1 class="text-4xl md:text-5xl font-bold text-teal-700">🏫 تقرير استراتيجي لمشروع: منصة مدارس المخا الرقمية</h1>
    </header>

    <!-- Introduction Section -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-gray-800 mb-4 flex items-center gap-3">
        <span class="text-teal-500">✨</span>
        مقدمة: نحو أفق جديد للتعليم .. تكنولوجيا تُنير المستقبل
      </h2>
      <p class="text-lg text-gray-700 leading-loose">
        في عصر التحول الرقمي المتسارع، أصبح دمج التكنولوجيا في التعليم ضرورة استراتيجية لبناء أجيال قادرة على مواكبة تحديات المستقبل. مشروع "منصة مدارس المخا" هو خطوة جريئة نحو هذا التحول، حيث يهدف إلى إحداث نقلة نوعية في التعليم داخل مديرية المخا، من خلال أتمتة الإجراءات وتقديم تجربة تعليمية رقمية متكاملة.
      </p>
    </section>

    <!-- Dashed separator -->
    <div class="my-12 border-t-2 border-dashed border-gray-300"></div>

    <!-- Strategic Goals Section -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-gray-800 mb-6 flex items-center gap-3">
        <span class="text-teal-500">🎯</span>
        الأهداف الاستراتيجية للمشروع
      </h2>
      <ul class="space-y-4 text-lg text-gray-700 pr-5">
        <li class="flex items-start"><span class="text-green-500 font-bold ml-3 rtl:ml-0 rtl:mr-3">✔</span> الارتقاء بجودة التعليم عبر بيئة تعليمية رقمية محفزة</li>
        <li class="flex items-start"><span class="text-green-500 font-bold ml-3 rtl:ml-0 rtl:mr-3">✔</span> تبسيط العمليات الإدارية والأكاديمية للمعلمين والمديرين</li>
        <li class="flex items-start"><span class="text-green-500 font-bold ml-3 rtl:ml-0 rtl:mr-3">✔</span> تحسين الكفاءة التشغيلية وتقليل الهدر في الوقت والموارد</li>
        <li class="flex items-start"><span class="text-green-500 font-bold ml-3 rtl:ml-0 rtl:mr-3">✔</span> تعزيز الشفافية والتواصل بين أطراف العملية التعليمية</li>
      </ul>
    </section>

    <div class="my-12 border-t-2 border-dashed border-gray-300"></div>

    <!-- Platform Architecture Section -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-gray-800 mb-6 flex items-center gap-3">
        <span class="text-teal-500">🧩</span>
        الهيكلية المعمارية للمنصة
      </h2>
      
      <!-- Public Portal Subsection -->
      <div class="mb-10">
        <h3 class="text-2xl font-semibold text-gray-700 mb-5">1️⃣ البوابة الخارجية (الموقع العام)</h3>
        <p class="text-lg text-gray-700 leading-loose mb-6">واجهة تعريفية وتفاعلية متاحة للجميع، وتضم:</p>
        <div class="overflow-x-auto">
            <table class="w-full text-lg shadow-lg rounded-lg overflow-hidden">
                <thead class="bg-teal-600 text-white">
                    <tr>
                        <th class="p-4 font-bold text-right">القسم</th>
                        <th class="p-4 font-bold text-right">الوصف</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    <tr class="border-b border-gray-200 hover:bg-teal-50 transition-colors duration-200">
                        <td class="p-4 font-semibold text-teal-800">الهوية البصرية</td>
                        <td class="p-4">تصميم مستلهم من تراث ميناء المخا باستخدام الذكاء الاصطناعي</td>
                    </tr>
                    <tr class="border-b border-gray-200 hover:bg-teal-50 transition-colors duration-200">
                        <td class="p-4 font-semibold text-teal-800">عرض المدارس</td>
                        <td class="p-4">إبراز المدارس المشاركة، مع نموذج مدرسة النور بالثوباني</td>
                    </tr>
                    <tr class="border-b border-gray-200 hover:bg-teal-50 transition-colors duration-200">
                        <td class="p-4 font-semibold text-teal-800">الملف التعريفي</td>
                        <td class="p-4">صفحة خاصة لكل مدرسة تشمل النبذة، الهيكل، الصور، والفعاليات</td>
                    </tr>
                    <tr class="border-b border-gray-200 hover:bg-teal-50 transition-colors duration-200">
                        <td class="p-4 font-semibold text-teal-800">نافذة الفرص</td>
                        <td class="p-4">عرض المنح الدراسية العالمية والمحلية</td>
                    </tr>
                     <tr class="border-b border-gray-200 hover:bg-teal-50 transition-colors duration-200">
                        <td class="p-4 font-semibold text-teal-800">المركز الإعلامي</td>
                        <td class="p-4">أخبار المدارس والمنح (تحديث شهري وتلقائي)</td>
                    </tr>
                     <tr class="border-b border-gray-200 hover:bg-teal-50 transition-colors duration-200">
                        <td class="p-4 font-semibold text-teal-800">بوابة التمكين</td>
                        <td class="p-4">محتوى إرشادي للطالب والمعلم، ودورات مستقبلية</td>
                    </tr>
                     <tr class="hover:bg-teal-50 transition-colors duration-200">
                        <td class="p-4 font-semibold text-teal-800">الوصول العالمي</td>
                        <td class="p-4">دعم 5 لغات رئيسية: العربية، الإنجليزية، الصينية، الروسية</td>
                    </tr>
                </tbody>
            </table>
        </div>
      </div>

      <!-- Internal Dashboards Subsection -->
      <div>
        <h3 class="text-2xl font-semibold text-gray-700 mb-5">2️⃣ المنظومة الداخلية (لوحات التحكم)</h3>
        <p class="text-lg text-gray-700 leading-loose mb-6">يتم الوصول إليها عبر تسجيل دخول موحد، وتشمل:</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8">
            <!-- School Admin Panel -->
            <div class="bg-gray-50 p-6 rounded-lg border-r-4 border-teal-500 shadow-md">
                <h4 class="text-xl font-bold text-gray-800 mb-4">🏫 لوحة الإدارة المدرسية</h4>
                <ul class="list-disc list-inside space-y-2 text-gray-700 pr-4">
                    <li>إدارة ملفات الطلاب والمعلمين</li>
                    <li>معالجة طلبات التسجيل</li>
                    <li>بناء قاعدة المواد الدراسية</li>
                    <li>رصد الدرجات وإنشاء دفتر درجات PDF</li>
                    <li>نظام الجداول الذكي (توزيع تلقائي)</li>
                    <li>إدارة الأنشطة (تحديث تلقائي للواجهة الخارجية)</li>
                </ul>
            </div>
            <!-- Student Panel -->
            <div class="bg-gray-50 p-6 rounded-lg border-r-4 border-blue-500 shadow-md">
                <h4 class="text-xl font-bold text-gray-800 mb-4">👨‍🎓 منصة الطالب</h4>
                <ul class="list-disc list-inside space-y-2 text-gray-700 pr-4">
                    <li>الوصول إلى المواد، الواجبات، الدرجات، الجدول</li>
                    <li>لوحة مؤشرات الأداء</li>
                    <li>نظام الرسوم الدراسية للمدارس الخاصة</li>
                </ul>
            </div>
            <!-- Teacher Panel -->
            <div class="bg-gray-50 p-6 rounded-lg border-r-4 border-purple-500 shadow-md">
                <h4 class="text-xl font-bold text-gray-800 mb-4">👩‍🏫 منصة المعلم</h4>
                <ul class="list-disc list-inside space-y-2 text-gray-700 pr-4">
                     <li>متابعة أداء الطلاب عبر الرسوم البيانية</li>
                     <li>إرسال وتقييم الواجبات إلكترونيًا</li>
                     <li>إدارة الطلاب والدرجات</li>
                     <li>الجدول الدراسي الديناميكي</li>
                     <li>اختبارات إلكترونية (جاهزة للتفعيل)</li>
                </ul>
            </div>
            <!-- General Supervision Panel -->
            <div class="bg-gray-50 p-6 rounded-lg border-r-4 border-red-500 shadow-md">
                <h4 class="text-xl font-bold text-gray-800 mb-4">🏢 لوحة الإشراف العام</h4>
                <ul class="list-disc list-inside space-y-2 text-gray-700 pr-4">
                    <li>إحصائيات حية للمدارس والطلاب</li>
                    <li>مؤشرات الأداء (حضور، نجاح، رسوب)</li>
                    <li>نظام تقارير مركزي بين المدارس والمكتب</li>
                </ul>
            </div>
        </div>
      </div>
    </section>
    
    <div class="my-12 border-t-2 border-dashed border-gray-300"></div>

    <!-- Roadmap Section -->
    <section class="mb-12">
      <h2 class="text-3xl font-bold text-gray-800 mb-6 flex items-center gap-3">
        <span class="text-teal-500">🛠️</span>
        خارطة الطريق: المتطلبات والخطوات المستقبلية
      </h2>
      <div class="grid md:grid-cols-1 lg:grid-cols-3 gap-8 text-lg">
        <!-- Logistic Requirements -->
        <div class="bg-blue-50 p-6 rounded-lg shadow-md border-t-4 border-blue-400">
            <h3 class="text-2xl font-semibold text-blue-800 mb-4">أ. المتطلبات اللوجستية</h3>
            <ul class="list-disc list-inside space-y-2 text-gray-700 pr-4">
                <li>توفير الإنترنت للمدارس</li>
                <li>تجهيز أجهزة الحاسوب والطابعات</li>
            </ul>
        </div>
        <!-- Content Requirements -->
        <div class="bg-green-50 p-6 rounded-lg shadow-md border-t-4 border-green-400">
            <h3 class="text-2xl font-semibold text-green-800 mb-4">ب. متطلبات المحتوى</h3>
            <ul class="list-disc list-inside space-y-2 text-gray-700 pr-4">
                <li>أسماء المدارس المستهدفة</li>
                <li>صورة رسمية لكل مدرسة</li>
                <li>محتوى إعلامي أولي (صور/فيديوهات)</li>
                <li>قوائم الكادر التعليمي والإداري</li>
            </ul>
        </div>
        <!-- Implementation Plan -->
        <div class="bg-yellow-50 p-6 rounded-lg shadow-md border-t-4 border-yellow-400">
            <h3 class="text-2xl font-semibold text-yellow-800 mb-4">ج. خطة التنفيذ</h3>
            <ol class="list-decimal list-inside space-y-2 text-gray-700 pr-4">
                <li>إنتاج فيديوهات تدريبية لكل مدرسة</li>
                <li>استضافة المنصة على خادم آمن</li>
                <li>إطلاق تجريبي لمدة شهر</li>
                <li>تدقيق فني شامل</li>
                <li>إطلاق رسمي بعد التحسينات</li>
            </ol>
        </div>
      </div>
    </section>

    <div class="my-12 border-t-2 border-dashed border-gray-300"></div>

    <!-- Conclusion and Recommendations Section -->
    <section>
        <h2 class="text-3xl font-bold text-gray-800 mb-4 flex items-center gap-3">
            <span class="text-teal-500">📌</span>
            خاتمة وتوصيات
        </h2>
        <p class="text-lg text-gray-700 leading-loose bg-teal-50 border-r-4 border-teal-500 p-6 rounded-lg shadow-md">
            مشروع "منصة مدارس المخا" هو استثمار في مستقبل التعليم، جاهز للتوسع والتطوير حسب احتياجات الميدان. نوصي بالبدء الفوري في المرحلة التجريبية، مع استعداد كامل لإضافة أو تعديل أي وظيفة حسب متطلبات الجهات الداعمة.
        </p>
    </section>

  </div>

</body>
</html>
